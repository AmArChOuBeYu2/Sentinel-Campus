# Server & Application Configuration
PORT=5000
NODE_ENV=development
VITE_API_BASE=/api
JWT_SECRET=your_jwt_secret_key_here

# Cryptographic OTP HMAC Secret (Required: 32+ character high-entropy key)
OTP_HMAC_SECRET=your_32_plus_character_secure_hmac_secret_here

# Resend Email Service Configuration (Required for live email OTP delivery)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev

# Local Diagnostic Recipient (Used by npm run test:resend only)
RESEND_TEST_TO=your_verified_test_email@example.com

# Local Development Demo Mode
# Set to 'false' in production to disable simulated OTP fallbacks
ALLOW_SIMULATED_OTP=true
