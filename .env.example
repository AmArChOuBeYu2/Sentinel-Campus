# Server & Application Configuration
PORT=5000
NODE_ENV=development
VITE_API_BASE=/api
JWT_SECRET=sentinel_campus_dev_secret_2026_skit_jaipur

# OTP Provider Adapter Configuration
# Options: 'simulated' (default for local development) or 'twilio' / 'msg91'
OTP_PROVIDER=simulated

# Optional Real OTP Provider Credentials (Required only when OTP_PROVIDER is not 'simulated')
# TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# TWILIO_AUTH_TOKEN=your_auth_token_here
# TWILIO_PHONE_NUMBER=+1234567890

# Demo Mode Settings
# Set to 'false' in production environments to disable simulated OTP (123456)
ALLOW_SIMULATED_OTP=true
